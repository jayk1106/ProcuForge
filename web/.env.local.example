# Local development — the rewrite in next.config.ts proxies /api/v1/* here,
# and the WebSocket client connects here directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Vercel) — set in the Vercel project dashboard, not here:
#
# Required:
#   API_PROXY_TARGET=https://procuforge-api-xxxxx-uc.a.run.app
#     Server-only. next.config.ts rewrites /api/v1/* on
#     procuforge.ratelxai.com to this URL so the session cookie is
#     first-party (browsers block third-party cookies in incognito and
#     in Safari/Firefox/Brave).
#
#   NEXT_PUBLIC_API_URL=https://procuforge-api-xxxxx-uc.a.run.app
#     Used by the browser only for WebSocket connections (Vercel does
#     not proxy WebSockets through rewrites). WS auth uses the ws-ticket
#     endpoint, so the session cookie is not needed for the WS handshake.
